# Prevent direct script execution in image uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|cgi|pl|exe|sh|bash|py|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP interpretation
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Strip executable handlers
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .inc
SetHandler default-handler

# Disable directory browsing and CGI execution
Options -Indexes -ExecCGI
