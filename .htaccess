# ==============================================================================
# Security & Performance Hardening Configuration - Dr. APJ University
# ==============================================================================

# Disable directory browsing (Directory Listing)
Options -Indexes -FollowSymLinks +SymLinksIfOwnerMatch

# Prevent direct access to hidden files and directories (.git, .env, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to sensitive file extensions (SQL dumps, backups, logs)
<FilesMatch "(?i)\.(sql|bak|log|ini|sh|env|config|dist|fla|psd|rar|tar|gz|7z)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect sensitive report spreadsheets in root directory
<Files "AKU_Website_Page_Comparison_Report.csv">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>
<Files "AKU_Website_Page_Comparison_Report.xls">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</Files>

# Security HTTP Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block HTTP TRACE and TRACK methods (XST protection)
RewriteEngine On
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
RewriteRule .* - [F]

# Block public access to internal development folders & backups
RewriteRule ^(scratch|uploads/db-backup|\.git)(/.*)?$ - [F,L]

# Custom URL Rewriting
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([^/]+)/?$ single.php?type=blog&slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^voi/([^/]+)/?$ single.php?type=voi&slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^event/([^/]+)/?$ single.php?type=event&slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^notice-board/([^/]+)/?$ single.php?type=notice&slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^announcements/([^/]+)/?$ single.php?type=announcement&slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^media-coverage-aku/([^/]+)/?$ single.php?type=media&slug=$1 [L,QSA]

# Check if the .php file exists
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [NC,L]

# If .php file doesn't exist, route it as a dynamic page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/?$ single.php?type=page&slug=$1 [L,QSA]